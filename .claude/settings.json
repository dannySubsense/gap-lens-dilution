      "args": [
        "-y",
        "mcp-remote",
        "https://askedgar.readme.io/mcp",
        "--header",
        "Authorization:${ASKEDGAR_API_KEY}"
      ]
    }
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/first-turn-contract.sh"
          }
        ]
      }
    ]
  }
}
